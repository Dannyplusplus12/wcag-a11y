{
  "name": "wcag-a11y",
  "version": "0.4.3",
  "description": "WCAG 2.1/2.2 accessibility auditor with AI-powered fixes. Crawls your dev server with Playwright, runs 40+ checks, and uses AI (12 providers) to generate fix prompts or patch source files directly.",
  "keywords": [
    "wcag",
    "accessibility",
    "a11y",
    "wcag2",
    "wcag21",
    "wcag22",
    "aria",
    "playwright",
    "ai",
    "audit",
    "fix",
    "cli",
    "gemini",
    "openai",
    "anthropic",
    "screen-reader"
  ],
  "type": "module",
  "bin": {
    "wcag-a11y": "dist/cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "playwright": "^1.60.0",
    "chalk": "^5.6.0"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "@types/node": "^25.9.0",
    "vitest": "^4.1.0",
    "tsx": "^4.22.0"
  }
}
